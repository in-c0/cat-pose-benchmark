{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatPose model bake-off prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "clip_id", "model", "source", "frames"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "clip_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "checkpoint", "commercial_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "commercial_status": {"enum": ["allowed", "research_only", "unknown", "research_only_or_unknown", "not_assessed_for_product"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "enum": [
            "per_frame_model_call_after_initialization",
            "whole_video_amortized_including_setup",
            "synthetic_fixture"
          ]
        },
        "notes": {"type": "string"}
      }
    },
    "skeleton_edges_3d": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}],
        "items": false
      }
    },
    "diagnostic_depth_pairs": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}],
        "items": false
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "keypoint2d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_name", "x_px", "y_px", "score"],
      "properties": {
        "native_name": {"type": "string", "minLength": 1},
        "canonical_name": {"type": ["string", "null"]},
        "x_px": {"type": "number"},
        "y_px": {"type": "number"},
        "score": {"type": "number", "minimum": 0}
      }
    },
    "keypoint3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_name", "x", "y", "z", "coordinate_frame"],
      "properties": {
        "native_name": {"type": "string", "minLength": 1},
        "canonical_name": {"type": ["string", "null"]},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"},
        "coordinate_frame": {"enum": ["camera", "root_relative", "world", "model_native"]},
        "score": {"type": "number", "minimum": 0}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "timestamp_s", "inference_ms", "keypoints_2d"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "timestamp_s": {"type": "number", "minimum": 0},
        "inference_ms": {"type": "number", "minimum": 0},
        "keypoints_2d": {"type": "array", "items": {"$ref": "#/$defs/keypoint2d"}},
        "keypoints_3d": {"type": "array", "items": {"$ref": "#/$defs/keypoint3d"}}
      }
    }
  }
}
