{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatPose feline detail observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence_id", "image", "frames"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "sequence_id": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_tier": {"enum": ["S", "R2", "R3", "G"]},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_px", "y_px", "visibility"],
      "properties": {
        "x_px": {"type": "number"},
        "y_px": {"type": "number"},
        "visibility": {"enum": ["visible", "partially_occluded", "fully_occluded", "out_of_frame"]},
        "confidence": {"type": "number", "minimum": 0},
        "provenance": {"type": "string"}
      }
    },
    "ear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "base_medial", "base_lateral", "tip"],
      "properties": {
        "side": {"enum": ["left", "right"]},
        "base_medial": {"$ref": "#/$defs/point"},
        "base_lateral": {"$ref": "#/$defs/point"},
        "tip": {"$ref": "#/$defs/point"}
      }
    },
    "tail_sample": {
      "allOf": [
        {"$ref": "#/$defs/point"},
        {
          "type": "object",
          "required": ["u"],
          "properties": {
            "u": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "tail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/tail_sample"}
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "timestamp_s", "ears", "tail"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "timestamp_s": {"type": "number", "minimum": 0},
        "ears": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/ear"}
        },
        "tail": {"$ref": "#/$defs/tail"}
      }
    }
  }
}
