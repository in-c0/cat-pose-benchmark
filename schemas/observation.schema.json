{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-pose-benchmark.example/schemas/observation.schema.json",
  "title": "Cat Pose Benchmark Observation",
  "description": "Observation with explicit source tier, provenance, visibility, and uncertainty. Tier S is exact inside simulation, R2 is observable real evidence, R3 is reconstructed/model-derived, and G1-G5 are independently operated external-gold measurement classes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "sequence_id",
    "subject_id",
    "observation_class",
    "semantic_name",
    "coordinate_space",
    "evidence_tier",
    "quality",
    "visibility",
    "source_ids",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "0.2.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "interval": {
      "$ref": "#/$defs/interval"
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_class": {
      "enum": [
        "surface_landmark",
        "surface_curve",
        "contact_event",
        "scene_geometry",
        "spatial_relation",
        "latent_anatomy",
        "derived_temporal"
      ]
    },
    "semantic_name": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_space": {
      "enum": [
        "image",
        "camera",
        "world",
        "subject_local",
        "surface",
        "time",
        "categorical"
      ]
    },
    "units": {
      "type": "string"
    },
    "mean": {
      "oneOf": [
        { "$ref": "#/$defs/vector" },
        { "$ref": "#/$defs/curve" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string" }
      ]
    },
    "covariance": {
      "$ref": "#/$defs/matrix"
    },
    "confidence_region": {
      "type": "object",
      "additionalProperties": true
    },
    "visibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "visible",
          "partially_occluded",
          "fully_occluded",
          "out_of_frame",
          "motion_blurred",
          "indistinguishable",
          "not_applicable"
        ]
      }
    },
    "evidence_tier": {
      "enum": [
        "S",
        "R2",
        "R3",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "U0"
      ]
    },
    "quality": {
      "enum": ["gold", "silver", "bronze", "unknown"]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    },
    "consent_record_id": {
      "type": "string"
    },
    "licence_record_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_class": {
            "const": "contact_event"
          }
        },
        "required": ["observation_class"]
      },
      "then": {
        "required": ["interval"]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "S"
          }
        },
        "required": ["evidence_tier"]
      },
      "then": {
        "required": ["validation"],
        "properties": {
          "quality": {
            "const": "gold"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "R3"
          }
        },
        "required": ["evidence_tier"]
      },
      "then": {
        "properties": {
          "quality": {
            "enum": ["silver", "bronze", "unknown"]
          }
        }
      }
    }
  ],
  "anyOf": [
    { "required": ["frame_index"] },
    { "required": ["interval"] },
    { "required": ["timestamp_ns"] }
  ],
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "curve": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/vector"
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ns", "end_ns"],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "start_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
